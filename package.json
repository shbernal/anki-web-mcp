  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-web-mcp.git"
  },
  "bin": {
    "anki-web-mcp": "dist/cli.js"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
