{
  "name": "anki-web-mcp",
  "version": "0.0.4",
  "description": "MCP server that searches, downloads and shares AnkiWeb decks from your own session.",
  "keywords": [
    "anki",
    "ankiweb",
    "flashcards",
    "mcp",
    "model-context-protocol",
    "playwright"
  ],
  "homepage": "https://github.com/shbernal/anki-web-mcp#readme",
  "bugs": {
    "url": "https://github.com/shbernal/anki-web-mcp/issues"
  },
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-web-mcp.git"
  },
  "bin": {
    "anki-web-mcp": "dist/cli.js"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ankimd/core": "^0.0.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
